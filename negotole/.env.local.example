# NextAuth
AUTH_SECRET=your_auth_secret_here
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis (レート制限用)
# セットアップ方法: docs/setup-upstash.md を参照
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Google フォーム (お問い合わせ・通報)
NEXT_PUBLIC_CONTACT_FORM_URL=https://forms.gle/YOUR_CONTACT_FORM_ID
NEXT_PUBLIC_REPORT_FORM_URL=https://docs.google.com/forms/d/YOUR_REPORT_FORM_ID/viewform

NEXT_PUBLIC_APP_URL=http://localhost:3000
